{
  "name": "wizard-chess-aistudio-applet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "([ -d node_modules/.bin ] || bun install || npm install) && node scripts/copy-basis-transcoder.mjs",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "([ -d node_modules/.bin ] || bun install || npm install) && node scripts/copy-basis-transcoder.mjs",
    "build": "vite build",
    "prelint": "[ -d node_modules/.bin ] || bun install || npm install",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "glb:unpack": "node scripts/glb-pipeline.mjs unpack",
    "glb:pack": "node scripts/glb-pipeline.mjs pack",
    "glb:restore": "node scripts/glb-pipeline.mjs restore-backup",
    "glb:encode": "node scripts/encode-glb-assets.mjs",
    "blender:sculpt": "python3 .tools/sculpt_pieces_via_mcp.py && node scripts/glb-pipeline.mjs pack",
    "deploy": "npm run build && CI=true npx wrangler deploy",
    "deploy:cf": "npm run build && CI=true npx wrangler deploy",
    "test": "node --test test/applet.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.170.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
