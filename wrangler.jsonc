{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wizard-chess-3d",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "chess.tqd.io.vn",
      "custom_domain": true
    },
    {
      "pattern": "chess.tqd.me",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],
  "vars": { "ROOMS_BACKEND": "durable" },
  "env": {
    "staging": {
      "name": "wizard-chess-3d-staging",
      "workers_dev": true,
      // Environments inherit routes; this empty list keeps staging off the production domain.
      "routes": [],
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }]
      },
      "vars": { "ROOMS_BACKEND": "durable" }
    }
  }
}
